{
  "name": "bell-theory",
  "private": true,
  "version": "0.1.0",
  "description": "A two-thumb endless runner. Thread it, or wreck it.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "smoke": "node test/harness.mjs",
    "smoke:one": "node test/harness.mjs --mode one",
    "smoke:proto": "node test/harness.mjs --url file://$PWD/prototype/index.html",
    "smoke:dist": "node test/harness.mjs --url file://$PWD/dist/index.html",
    "smoke:preview": "node test/harness.mjs --serve dist",
    "icons": "node test/render-icons.mjs",
    "lint": "eslint src test/harness.mjs",
    "fonts:check": "node test/fonts-check.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "1.56.1",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
